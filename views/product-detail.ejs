<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.title %> - GkpKart</title>
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --accent: #f59e0b;
            --success: #10b981;
            --whatsapp: #25d366;
            --whatsapp-hover: #1ebe57;
            --cart-btn: #4f46e5;
            --cart-hover: #4338ca;
            --bg-color: #f8fafc;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            padding: 20px;
            line-height: 1.5;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            background: var(--card-bg);
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            border: 1px solid var(--border-color);
        }

        .back-link {
            text-decoration: none;
            color: var(--primary);
            font-weight: 700;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 20px;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: var(--primary-dark);
        }

        .product-flex {
            display: flex;
            gap: 40px;
            flex-wrap: wrap;
        }
        
        /* Gallery Styling */
        .gallery-container {
            display: flex;
            gap: 16px;
            max-width: 550px;
            width: 100%;
        }

        .thumbnails-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-height: 480px;
            overflow-y: auto;
            width: 85px;
            padding-right: 4px;
        }

        .thumbnails-list::-webkit-scrollbar {
            width: 4px;
        }
        .thumbnails-list::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        .thumb-item {
            width: 75px;
            height: 75px;
            border: 2px solid var(--border-color);
            border-radius: 8px;
            cursor: pointer;
            object-fit: cover;
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }

        .thumb-item:hover {
            border-color: var(--primary);
        }

        .thumb-item.active {
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
        }

        .thumb-item img, .thumb-item video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 6px;
        }
        
        /* Main Preview Box */
        .main-preview-box {
            flex: 1;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            height: 480px;
            overflow: hidden;
            cursor: zoom-in;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
            touch-action: pan-y;
        }

        .main-preview-box img, .main-preview-box video {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            user-select: none;
            transition: transform 0.3s ease;
        }
        
        /* Slider Navigation Arrows on Main Image */
        .slider-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid var(--border-color);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            color: var(--text-main);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            z-index: 5;
            transition: all 0.2s;
        }

        .slider-arrow:hover {
            background: #fff;
            color: var(--primary);
            transform: translateY(-50%) scale(1.05);
        }

        .prev-arrow { left: 12px; }
        .next-arrow { right: 12px; }

        /* Fullscreen Lightbox Modal */
        #lightbox-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.94);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        #lightbox-content {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        #lightbox-content img {
            max-width: 90vw;
            max-height: 90vh;
            object-fit: contain;
            display: block;
            cursor: grab;
            transform-origin: center center;
            transition: transform 0.05s ease-out;
        }

        #lightbox-content img:active {
            cursor: grabbing;
        }

        #lightbox-content video {
            max-width: 90vw;
            max-height: 90vh;
            object-fit: contain;
            display: block;
        }

        .lightbox-close {
            position: absolute;
            top: 24px;
            right: 32px;
            color: white;
            font-size: 32px;
            font-weight: bold;
            cursor: pointer;
            z-index: 1010;
            background: rgba(255, 255, 255, 0.1);
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }

        .lightbox-close:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        .lightbox-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255, 255, 255, 0.2);
            color: white;
            border: none;
            font-size: 24px;
            width: 50px;
            height: 50px;
            cursor: pointer;
            z-index: 1010;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }

        .lightbox-arrow:hover { background: rgba(255, 255, 255, 0.4); }
        .lightbox-prev { left: 24px; }
        .lightbox-next { right: 24px; }

        .product-info {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        h1 {
            color: var(--text-main);
            font-size: 28px;
            margin-top: 0;
            font-weight: 700;
        }

        .brand {
            color: var(--text-muted);
            font-size: 15px;
            margin-bottom: 12px;
        }

        .rating-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
        }

        .rating-badge {
            background: var(--success);
            color: white;
            padding: 4px 10px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 13px;
        }

        .price {
            font-size: 26px;
            color: #e11d48;
            font-weight: 800;
            margin: 10px 0 16px 0;
        }

        .description-box {
            color: #475569;
            font-size: 15px;
            margin-bottom: 12px;
        }

        .policy-box {
            color: #059669;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .whatsapp-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: var(--whatsapp);
            color: white;
            padding: 14px 20px;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 15px;
            margin-bottom: 12px;
            width: 100%;
            box-sizing: border-box;
            transition: background-color 0.2s, transform 0.1s;
            box-shadow: 0 4px 12px rgba(37, 211, 102, 0.2);
        }

        .whatsapp-btn:hover {
            background-color: var(--whatsapp-hover);
            transform: translateY(-1px);
        }

        /* Add to Cart Button Styling */
        .cart-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: var(--cart-btn);
            color: white;
            padding: 14px 20px;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 15px;
            margin-bottom: 20px;
            width: 100%;
            box-sizing: border-box;
            border: none;
            cursor: pointer;
            transition: background-color 0.2s, transform 0.1s;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
        }

        .cart-btn:hover {
            background-color: var(--cart-hover);
            transform: translateY(-1px);
        }

        .order-box {
            background: #f8fafc;
            padding: 20px;
            border: 1px solid var(--border-color);
            border-radius: 12px;
        }

        .order-box h3 {
            margin-top: 0;
            color: var(--primary);
            font-size: 18px;
            margin-bottom: 16px;
        }

        .section-title {
            margin-top: 40px;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 8px;
            color: var(--primary);
            font-size: 20px;
        }

        .review-card {
            background: #f8fafc;
            padding: 16px;
            border-radius: 10px;
            margin-bottom: 12px;
            border: 1px solid var(--border-color);
        }

        .form-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            font-size: 14px;
            color: var(--text-main);
        }

        input[type="text"], select, textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 14px;
            background: #fff;
            color: var(--text-main);
            outline: none;
            transition: border-color 0.2s;
        }

        input[type="text"]:focus, select:focus, textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        textarea { height: 90px; resize: vertical; }

        button[type="submit"] {
            background-color: var(--primary);
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 700;
            font-size: 15px;
            width: 100%;
            transition: background-color 0.2s;
        }

        button[type="submit"]:hover {
            background-color: var(--primary-dark);
        }

        .order-submit-btn {
            background-color: var(--accent) !important;
            color: #111827 !important;
        }

        .order-submit-btn:hover {
            background-color: #d97706 !important;
            color: white !important;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            body { padding: 10px; }
            .container { padding: 16px; }
            .product-flex { flex-direction: column; gap: 20px; }
            .gallery-container { flex-direction: column-reverse; max-width: 100%; }
            .thumbnails-list {
                flex-direction: row;
                width: 100%;
                max-height: none;
                overflow-x: auto;
                padding-bottom: 4px;
            }
            .thumb-item { width: 65px; height: 65px; }
            .main-preview-box { height: 320px; }
            h1 { font-size: 22px; }
            .price { font-size: 22px; }
        }
    </style>
</head>
<body>

    <div class="container">
        <a href="/" class="back-link">&larr; Back to Home</a>
        
        <div class="product-flex">
            
            <!-- Media Gallery Section -->
            <div class="gallery-container">
                <!-- Left Side Thumbnails -->
                <div class="thumbnails-list">
                    <% 
                        let allMedia = [];
                        if (product.images && product.images.length > 0) {
                            product.images.forEach(img => allMedia.push({ type: 'image', url: img }));
                        }
                        if (product.videos && product.videos.length > 0) {
                            product.videos.forEach(vid => allMedia.push({ type: 'video', url: vid }));
                        }
                    %>

                    <% allMedia.forEach((media, index) => { %>
                        <div class="thumb-item <%= index === 0 ? 'active' : '' %>" onclick="changeMedia('<%= media.url %>', '<%= media.type %>', <%= index %>)">
                            <% if (media.type === 'image') { %>
                                <img src="<%= media.url %>" alt="Thumbnail">
                            <% } else { %>
                                <video src="<%= media.url %>"></video>
                                <div style="position: absolute; color: white; font-size: 12px; background: rgba(0,0,0,0.7); padding: 2px 6px; border-radius: 4px;">▶</div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>

                <!-- Right Side Main Preview -->
                <div class="main-preview-box" id="mainPreviewBox" onclick="openLightbox()">
                    <button class="slider-arrow prev-arrow" onclick="event.stopPropagation(); slideMedia(-1)">&#10094;</button>
                    <button class="slider-arrow next-arrow" onclick="event.stopPropagation(); slideMedia(1)">&#10095;</button>
                    
                    <div id="mainDisplayArea" style="width:100%; height:100%; display:flex; align-items:center; justify-content:center;">
                        <% if (allMedia.length > 0) { %>
                            <% if (allMedia[0].type === 'image') { %>
                                <img id="activeMainImg" src="<%= allMedia[0].url %>" alt="<%= product.title %>">
                            <% } else { %>
                                <video id="activeMainVid" src="<%= allMedia[0].url %>" controls autoplay muted style="max-width:100%; max-height:100%;"></video>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <!-- Product Information -->
            <div class="product-info">
                <h1><%= product.title %></h1>
                <div class="brand">Brand: <strong><%= product.brand %></strong></div>
                
                <div class="rating-wrapper">
                    <span class="rating-badge">
                        ★ <%= averageRating > 0 ? averageRating : 'No Rating' %> / 5
                    </span>
                    <span style="color: var(--text-muted); font-size: 14px;">(<%= product.reviews.length %> Reviews)</span>
                </div>

                <div class="price">₹<%= product.price %></div>
                <div class="description-box"><strong>Description:</strong> <%= product.description %></div>
                <div class="policy-box"><strong>Policy:</strong> <%= product.returnPolicy %></div>

                <!-- Direct WhatsApp Business Chat Button -->
                <a href="https://wa.me/<%= product.whatsappNumber %>?text=Hello,%20I%20am%20interested%20in%20buying%20this%20product:%20<%= encodeURIComponent(product.title) %>" target="_blank" class="whatsapp-btn">
                    💬 Chat on WhatsApp with Seller
                </a>

                <!-- LIVE Add to Cart Button Form -->
                <form action="/cart/add/<%= product._id %>" method="POST">
                    <button type="submit" class="cart-btn">
                        🛒 Add to Cart
                    </button>
                </form>

                <!-- LIVE Order Now Form Box -->
                <div class="order-box">
                    <h3>📦 Place Order Directly</h3>
                    <form action="/order/<%= product._id %>" method="POST">
                        <div class="form-group">
                            <label for="customerName">Your Name:</label>
                            <input type="text" id="customerName" name="customerName" required placeholder="Enter your full name">
                        </div>

                        <div class="form-group">
                            <label for="customerPhone">Mobile Number:</label>
                            <input type="text" id="customerPhone" name="customerPhone" required placeholder="Enter mobile number">
                        </div>

                        <div class="form-group">
                            <label for="customerAddress">Area / Location / Address:</label>
                            <input type="text" id="customerAddress" name="customerAddress" required placeholder="Enter area, city or address">
                        </div>

                        <button type="submit" class="order-submit-btn">Confirm Order Now</button>
                    </form>
                </div>

            </div>
        </div>

        <h3 class="section-title">Customer Reviews & Ratings</h3>

        <% if (product.reviews.length === 0) { %>
            <p style="color: var(--text-muted); padding: 10px 0;">No reviews yet. Be the first one to review this product!</p>
        <% } else { %>
            <% product.reviews.forEach(review => { %>
                <div class="review-card">
                    <strong><%= review.user %></strong> 
                    <span style="color: #f59e0b; font-weight: bold; margin-left: 10px;">
                        <% for(let i=0; i<review.rating; i++) { %>★<% } %>
                    </span>
                    <p style="margin: 6px 0 0 0; color: #475569;"><%= review.comment %></p>
                </div>
            <% }) %>
        <% } %>

        <h3 class="section-title">Leave a Review</h3>
        <form action="/product/<%= product._id %>/reviews" method="POST" style="margin-top: 15px;">
            <div class="form-group">
                <label for="user">Your Name:</label>
                <input type="text" id="user" name="user" required placeholder="Enter your name">
            </div>

            <div class="form-group">
                <label for="rating">Rating (1 to 5 Stars):</label>
                <select id="rating" name="rating" required>
                    <option value="5">★★★★★ (5 Stars - Excellent)</option>
                    <option value="4">★★★★☆ (4 Stars - Good)</option>
                    <option value="3">★★★☆☆ (3 Stars - Average)</option>
                    <option value="2">★★☆☆☆ (2 Stars - Poor)</option>
                    <option value="1">★☆☆☆☆ (1 Star - Very Bad)</option>
                </select>
            </div>

            <div class="form-group">
                <label for="comment">Your Review Comment:</label>
                <textarea id="comment" name="comment" required placeholder="Write your experience with this product..."></textarea>
            </div>

            <button type="submit">Submit Review</button>
        </form>
    </div>

    <!-- Fullscreen Lightbox Modal -->
    <div id="lightbox-modal">
        <span class="lightbox-close" onclick="closeLightbox()">&times;</span>
        <button class="lightbox-arrow lightbox-prev" onclick="slideLightbox(-1)">&#10094;</button>
        <button class="lightbox-arrow lightbox-next" onclick="slideLightbox(1)">&#10095;</button>
        <div id="lightbox-content">
            <!-- Dynamic Lightbox Media -->
        </div>
    </div>

    <!-- Gallery, Zoom & Swipe / Slide JavaScript -->
    <script>
        const mediaList = <%- JSON.stringify(allMedia) %>;
        let currentIndex = 0;

        function changeMedia(url, type, index) {
            currentIndex = index;
            const displayArea = document.getElementById('mainDisplayArea');
            if (type === 'image') {
                displayArea.innerHTML = `<img src="${url}" alt="Product Preview">`;
            } else {
                displayArea.innerHTML = `<video src="${url}" controls autoplay muted style="max-width:100%; max-height:100%;"></video>`;
            }

            document.querySelectorAll('.thumb-item').forEach((item, idx) => {
                if (idx === index) {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });
        }

        function slideMedia(direction) {
            if (mediaList.length === 0) return;
            currentIndex = (currentIndex + direction + mediaList.length) % mediaList.length;
            const media = mediaList[currentIndex];
            changeMedia(media.url, media.type, currentIndex);
        }

        // Fullscreen Lightbox Variables & Functions
        let scale = 1;
        let pointX = 0;
        let pointY = 0;
        let isPanning = false;
        let startX = 0, startY = 0;

        function openLightbox() {
            if (mediaList.length === 0) return;
            const modal = document.getElementById('lightbox-modal');
            modal.style.display = 'flex';
            resetZoom();
            updateLightboxContent();
        }

        function closeLightbox() {
            document.getElementById('lightbox-modal').style.display = 'none';
        }

        function slideLightbox(direction) {
            if (mediaList.length === 0) return;
            currentIndex = (currentIndex + direction + mediaList.length) % mediaList.length;
            resetZoom();
            updateLightboxContent();
        }

        function resetZoom() {
            scale = 1;
            pointX = 0;
            pointY = 0;
        }

        function updateLightboxContent() {
            const contentBox = document.getElementById('lightbox-content');
            const media = mediaList[currentIndex];
            if (media.type === 'image') {
                contentBox.innerHTML = `<img id="lightboxImg" src="${media.url}" alt="Fullscreen Image" style="transform: translate(${pointX}px, ${pointY}px) scale(${scale});">`;
                setupZoomAndPan();
            } else {
                contentBox.innerHTML = `<video src="${media.url}" controls autoplay style="max-width:90vw; max-height:90vh;"></video>`;
            }
        }

        function setTransform(img) {
            img.style.transform = `translate(${pointX}px, ${pointY}px) scale(${scale})`;
        }

        function setupZoomAndPan() {
            const img = document.getElementById('lightboxImg');
            if (!img) return;

            // Mouse Wheel Zoom on Cursor Position
            img.addEventListener('wheel', (e) => {
                e.preventDefault();
                const xs = (e.clientX - pointX) / scale;
                const ys = (e.clientY - pointY) / scale;
                
                const delta = e.deltaY < 0 ? 1.15 : 0.85;
                let newScale = scale * delta;

                // Limit min & max zoom
                if (newScale < 1) {
                    newScale = 1;
                    pointX = 0;
                    pointY = 0;
                } else if (newScale > 5) {
                    newScale = 5;
                }

                if (newScale > 1) {
                    pointX = e.clientX - xs * newScale;
                    pointY = e.clientY - ys * newScale;
                }

                scale = newScale;
                setTransform(img);
            }, {passive: false});

            // Click & Drag (Pan) Support
            img.addEventListener('mousedown', (e) => {
                if (scale === 1) return; // Don't pan if not zoomed
                isPanning = true;
                startX = e.clientX - pointX;
                startY = e.clientY - pointY;
                img.style.cursor = 'grabbing';
            });

            window.addEventListener('mousemove', (e) => {
                if (!isPanning) return;
                e.preventDefault();
                pointX = e.clientX - startX;
                pointY = e.clientY - startY;
                setTransform(img);
            });

            window.addEventListener('mouseup', () => {
                isPanning = false;
                if(img) img.style.cursor = scale > 1 ? 'grab' : 'default';
            });
        }

        // Touch Swipe Support for main preview box
        const mainBox = document.getElementById('mainPreviewBox');
        let touchStartX = 0;
        let touchEndX = 0;

        mainBox.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, {passive: true});

        mainBox.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            let threshold = 50;
            if (touchEndX < touchStartX - threshold) slideMedia(1);
            if (touchEndX > touchStartX + threshold) slideMedia(-1);
        }, {passive: true});
    </script>
</body>
</html>
