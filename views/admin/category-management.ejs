<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= categoryName %> - Order & Product Management</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background-color: #f4f6f9; color: #333; }
        header { background: #343a40; color: white; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; }
        .container { max-width: 1400px; margin: 20px auto; padding: 10px; }
        .back-btn { background: #6c757d; color: white; padding: 8px 15px; text-decoration: none; border-radius: 4px; font-size: 14px; }
        
        /* Section styling */
        .section-box { background: white; border: 2px solid #000; border-radius: 6px; margin-bottom: 30px; padding: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .section-title { text-align: center; font-weight: bold; font-size: 18px; background: #e9ecef; border: 1px solid #000; padding: 8px; margin-bottom: 15px; }
        
        .table-controls { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 10px; }
        .search-box input { padding: 6px; width: 200px; border: 1px solid #28a745; border-radius: 4px; }
        .filter-box { border: 1px solid #28a745; padding: 5px 10px; border-radius: 4px; font-size: 13px; font-weight: bold; color: #28a745; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
        th, td { border: 1px solid #000; padding: 8px; text-align: center; }
        th { background: #fff; color: red; }
        
        .export-btn { margin-top: 10px; float: right; background: #fff; border: 1px solid #28a745; color: #28a745; padding: 5px 15px; font-weight: bold; cursor: pointer; border-radius: 4px; text-decoration: none; display: inline-block; }
        .export-btn:hover { background: #28a745; color: #fff; }
        
        .action-btn { padding: 5px 10px; background: #007bff; color: white; border: none; border-radius: 3px; cursor: pointer; font-size: 12px; }
        .cancel-btn { background: #dc3545; }
        .clear-fix::after { content: ""; clear: both; display: table; }
    </style>
</head>
<body>

    <header>
        <h2>Category: <%= categoryName %></h2>
        <a href="/admin/dashboard" class="back-btn">Back to Dashboard</a>
    </header>

    <div class="container">

        <!-- ================= TABLE 1: NEW ORDER ITEM ================= -->
        <div class="section-box">
            <div class="section-title">New Order Item</div>
            <div class="table-controls">
                <div class="search-box"><input type="text" placeholder="Search here..." onkeyup="filterTable(this, 'newTable')"></div>
                <div class="filter-box">Filter By time</div>
                <div class="filter-box">Filter By Date</div>
            </div>
            <table id="newTable">
                <thead>
                    <tr>
                        <th>S.N.</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Price</th>
                        <th>Product Name</th>
                        <th>Product Image</th>
                        <th>Customer Name</th>
                        <th>Mobile No.</th>
                        <th>Customer Location</th>
                        <th>Confirm Status</th>
                        <th>Item Packed</th>
                        <th>Item Cancel</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (newOrders && newOrders.length > 0) { %>
                        <% newOrders.forEach((order, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                <td><%= new Date(order.createdAt).toLocaleTimeString() %></td>
                                <td>₹<%= order.product ? order.product.price : 'N/A' %></td>
                                <td><%= order.product ? order.product.title : 'N/A' %></td>
                                <td>
                                    <% if (order.product && order.product.images && order.product.images.length > 0) { %>
                                        <img src="<%= order.product.images[0] %>" width="40" height="40" style="object-fit:cover;">
                                    <% } %>
                                </td>
                                <td><%= order.customerName %></td>
                                <td><%= order.phone %></td>
                                <td><%= order.location %></td>
                                <td style="color: green; font-weight: bold;">Confirm</td>
                                <td>
                                    <form action="/admin/order/pack/<%= order._id %>" method="POST">
                                        <button type="submit" class="action-btn">Packed</button>
                                    </form>
                                </td>
                                <td>
                                    <form action="/admin/order/status/<%= order._id %>" method="POST" onsubmit="return confirmCancel(this)">
                                        <input type="hidden" name="status" value="Canceled">
                                        <input type="hidden" name="cancelReason" value="Canceled from New Order stage">
                                        <button type="submit" class="action-btn cancel-btn">Cancel</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="12" style="text-align: center; color: #777;">No new orders found.</td></tr>
                    <% } %>
                </tbody>
            </table>
            <div class="clear-fix"><button class="export-btn" onclick="exportTableToExcel('newTable', '<%= categoryName %>_New_Orders')">Export In Excel</button></div>
        </div>

        <!-- ================= TABLE 2: PACKED ITEM ================= -->
        <div class="section-box">
            <div class="section-title">Packed Item</div>
            <div class="table-controls">
                <div class="search-box"><input type="text" placeholder="Search here..." onkeyup="filterTable(this, 'packedTable')"></div>
                <div class="filter-box">Filter By time</div>
                <div class="filter-box">Filter By Date</div>
            </div>
            <table id="packedTable">
                <thead>
                    <tr>
                        <th>S.N.</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Price</th>
                        <th>Product Name</th>
                        <th>Product Image</th>
                        <th>Customer Name</th>
                        <th>Mobile No.</th>
                        <th>Customer Location</th>
                        <th>Confirm Status</th>
                        <th>Delivery Boy I'D</th>
                        <th>Manual Secret code</th>
                        <th>Out For Delivery</th>
                        <th>Item Cancel</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (packedOrders && packedOrders.length > 0) { %>
                        <% packedOrders.forEach((order, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                <td><%= new Date(order.createdAt).toLocaleTimeString() %></td>
                                <td>₹<%= order.product ? order.product.price : 'N/A' %></td>
                                <td><%= order.product ? order.product.title : 'N/A' %></td>
                                <td>
                                    <% if (order.product && order.product.images && order.product.images.length > 0) { %>
                                        <img src="<%= order.product.images[0] %>" width="40" height="40" style="object-fit:cover;">
                                    <% } %>
                                </td>
                                <td><%= order.customerName %></td>
                                <td><%= order.phone %></td>
                                <td><%= order.location %></td>
                                <td style="color: green; font-weight: bold;">Confirm</td>
                                <form action="/admin/order/dispatch/<%= order._id %>" method="POST">
                                    <td>
                                        <select name="deliveryBoyId" required style="padding: 4px;">
                                            <option value="">Select Delivery Boy</option>
                                            <% deliveryBoys.forEach(boy => { %>
                                                <option value="<%= boy.id %>"><%= boy.id %></option>
                                            <% }) %>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" name="manualSecretCode" value="<%= order.secretKey %>" required style="width: 70px; text-align: center;">
                                    </td>
                                    <td>
                                        <button type="submit" class="action-btn" style="background: #ffc107; color: #000;">Dispatch</button>
                                    </td>
                                </form>
                                <td>
                                    <form action="/admin/order/status/<%= order._id %>" method="POST" onsubmit="return confirmCancel(this)">
                                        <input type="hidden" name="status" value="Canceled">
                                        <input type="hidden" name="cancelReason" value="Canceled from Packed stage">
                                        <button type="submit" class="action-btn cancel-btn">Cancel</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="14" style="text-align: center; color: #777;">No packed orders found.</td></tr>
                    <% } %>
                </tbody>
            </table>
            <div class="clear-fix"><button class="export-btn" onclick="exportTableToExcel('packedTable', '<%= categoryName %>_Packed_Orders')">Export In Excel</button></div>
        </div>

        <!-- ================= TABLE 3: OUT FOR DELIVERY ================= -->
        <div class="section-box">
            <div class="section-title">Out For Delivery</div>
            <div class="table-controls">
                <div class="search-box"><input type="text" placeholder="Search here..." onkeyup="filterTable(this, 'ofdTable')"></div>
                <div class="filter-box">Filter By time</div>
                <div class="filter-box">Filter By Date</div>
            </div>
            <table id="ofdTable">
                <thead>
                    <tr>
                        <th>S.N.</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Price</th>
                        <th>Product Name</th>
                        <th>Product Image</th>
                        <th>Customer Name</th>
                        <th>Mobile No.</th>
                        <th>Customer Location</th>
                        <th>Confirm Status</th>
                        <th>Delivery Boy ID</th>
                        <th>Manual Secret Code</th>
                        <th>Delivery Status</th>
                        <th>Item Cancel</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (outForDeliveryOrders && outForDeliveryOrders.length > 0) { %>
                        <% outForDeliveryOrders.forEach((order, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                <td><%= new Date(order.createdAt).toLocaleTimeString() %></td>
                                <td>₹<%= order.product ? order.product.price : 'N/A' %></td>
                                <td><%= order.product ? order.product.title : 'N/A' %></td>
                                <td>
                                    <% if (order.product && order.product.images && order.product.images.length > 0) { %>
                                        <img src="<%= order.product.images[0] %>" width="40" height="40" style="object-fit:cover;">
                                    <% } %>
                                </td>
                                <td><%= order.customerName %></td>
                                <td><%= order.phone %></td>
                                <td><%= order.location %></td>
                                <td style="color: green; font-weight: bold;">Confirm</td>
                                <td><%= order.deliveryBoyId %></td>
                                <td><%= order.secretKey %></td>
                                <td>
                                    <form action="/admin/order/status/<%= order._id %>" method="POST" style="display:inline;">
                                        <input type="hidden" name="status" value="Delivered">
                                        <button type="submit" class="action-btn" style="background: #28a745;">Mark Delivered</button>
                                    </form>
                                </td>
                                <td>
                                    <form action="/admin/order/status/<%= order._id %>" method="POST" onsubmit="return confirmCancel(this)" style="display:inline;">
                                        <input type="hidden" name="status" value="Canceled">
                                        <input type="hidden" name="cancelReason" value="Canceled from Out For Delivery stage">
                                        <button type="submit" class="action-btn cancel-btn">Cancel</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="14" style="text-align: center; color: #777;">No orders out for delivery.</td></tr>
                    <% } %>
                </tbody>
            </table>
            <div class="clear-fix"><button class="export-btn" onclick="exportTableToExcel('ofdTable', '<%= categoryName %>_OutForDelivery_Orders')">Export In Excel</button></div>
        </div>

        <!-- ================= TABLE 4: DELIVERED ITEM ================= -->
        <div class="section-box">
            <div class="section-title">Delivered Item</div>
            <div class="table-controls">
                <div class="search-box"><input type="text" placeholder="Search here..." onkeyup="filterTable(this, 'deliveredTable')"></div>
                <div class="filter-box">Filter By time</div>
                <div class="filter-box">Filter By Date</div>
            </div>
            <table id="deliveredTable">
                <thead>
                    <tr>
                        <th>S.N.</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Price</th>
                        <th>Product Name</th>
                        <th>Product Image</th>
                        <th>Customer Name</th>
                        <th>Mobile No.</th>
                        <th>Customer Location</th>
                        <th>Delivered Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (deliveredOrders && deliveredOrders.length > 0) { %>
                        <% deliveredOrders.forEach((order, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                <td><%= new Date(order.createdAt).toLocaleTimeString() %></td>
                                <td>₹<%= order.product ? order.product.price : 'N/A' %></td>
                                <td><%= order.product ? order.product.title : 'N/A' %></td>
                                <td>
                                    <% if (order.product && order.product.images && order.product.images.length > 0) { %>
                                        <img src="<%= order.product.images[0] %>" width="40" height="40" style="object-fit:cover;">
                                    <% } %>
                                </td>
                                <td><%= order.customerName %></td>
                                <td><%= order.phone %></td>
                                <td><%= order.location %></td>
                                <td style="color: green; font-weight: bold;">Successfully Delivered</td>
                                <td>
                                    <form action="/admin/order/delete/<%= order._id %>" method="POST" onsubmit="return confirm('WARNING: Are you sure you want to delete this delivered item record?')">
                                        <button type="submit" class="action-btn cancel-btn">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="11" style="text-align: center; color: #777;">No delivered items found.</td></tr>
                    <% } %>
                </tbody>
            </table>
            <div class="clear-fix"><button class="export-btn" onclick="exportTableToExcel('deliveredTable', '<%= categoryName %>_Delivered_Orders')">Export In Excel</button></div>
        </div>

        <!-- ================= TABLE 5: CANCELED ITEM ================= -->
        <div class="section-box">
            <div class="section-title">Canceled Item</div>
            <div class="table-controls">
                <div class="search-box"><input type="text" placeholder="Search here..." onkeyup="filterTable(this, 'canceledTable')"></div>
                <div class="filter-box">Filter By time</div>
                <div class="filter-box">Filter By Date</div>
            </div>
            <table id="canceledTable">
                <thead>
                    <tr>
                        <th>S.N.</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Price</th>
                        <th>Product Name</th>
                        <th>Product Image</th>
                        <th>Customer Name</th>
                        <th>Mobile No.</th>
                        <th>Customer Location</th>
                        <th>Confirm Status</th>
                        <th>Delivered Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (canceledOrders && canceledOrders.length > 0) { %>
                        <% canceledOrders.forEach((order, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                <td><%= new Date(order.createdAt).toLocaleTimeString() %></td>
                                <td>₹<%= order.product ? order.product.price : 'N/A' %></td>
                                <td><%= order.product ? order.product.title : 'N/A' %></td>
                                <td>
                                    <% if (order.product && order.product.images && order.product.images.length > 0) { %>
                                        <img src="<%= order.product.images[0] %>" width="40" height="40" style="object-fit:cover;">
                                    <% } %>
                                </td>
                                <td><%= order.customerName %></td>
                                <td><%= order.phone %></td>
                                <td><%= order.location %></td>
                                <td>Canceled</td>
                                <td style="color: red; font-weight: bold;"><%= order.cancelReason || 'Canceled' %></td>
                                <td>
                                    <form action="/admin/order/delete/<%= order._id %>" method="POST" onsubmit="return confirm('WARNING: Are you sure you want to delete this canceled order record?')">
                                        <button type="submit" class="action-btn cancel-btn">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="12" style="text-align: center; color: #777;">No canceled items found.</td></tr>
                    <% } %>
                </tbody>
            </table>
            <div class="clear-fix"><button class="export-btn" onclick="exportTableToExcel('canceledTable', '<%= categoryName %>_Canceled_Orders')">Export In Excel</button></div>
        </div>

    </div>

    <script>
        // Search filter logic for tables
        function filterTable(input, tableId) {
            let filter = input.value.toLowerCase();
            let table = document.getElementById(tableId);
            let tr = table.getElementsByTagName("tr");

            for (let i = 1; i < tr.length; i++) {
                let td = tr[i].getElementsByTagName("td");
                let match = false;
                for (let j = 0; j < td.length; j++) {
                    if (td[j]) {
                        if (td[j].innerHTML.toLowerCase().indexOf(filter) > -1) {
                            match = true;
                            break;
                        }
                    }
                }
                tr[i].style.display = match ? "" : "none";
            }
        }

        // Confirm cancellation with prompt
        function confirmCancel(form) {
            let reason = prompt("Please enter the reason for cancellation:");
            if (reason === null || reason.trim() === "") {
                alert("Cancellation aborted. Reason is required.");
                return false;
            }
            form.querySelector('input[name="cancelReason"]').value = reason;
            return true;
        }

        // Export table to Excel functionality
        function exportTableToExcel(tableId, filename = 'excel_data') {
            let downloadLink;
            let dataType = 'application/vnd.ms-excel';
            let tableSelect = document.getElementById(tableId);
            let tableHTML = tableSelect.outerHTML.replace(/<form[^>]*>|<\/form>/gi, ''); // remove forms for clean excel

            downloadLink = document.createElement("a");
            document.body.appendChild(downloadLink);

            let blob = new Blob(['\ufeff', tableHTML], { type: dataType });
            let url = URL.createObjectURL(blob);
            downloadLink.href = url;
            downloadLink.download = filename + '.xls';
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
</body>
</html>
