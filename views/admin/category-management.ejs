<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Category: <%= categoryName %> - GkpKart Admin</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f6f9; margin: 0; padding: 10px; color: #333; }
        .container { max-width: 1200px; margin: 10px auto; background: white; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        
        h2, h3 { color: #333; margin-top: 0; }
        .header-flex { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px; }
        
        .btn { display: inline-block; padding: 8px 12px; background: #007bff; color: white; text-decoration: none; border-radius: 4px; font-size: 14px; border: none; cursor: pointer; text-align: center; }
        .btn:hover { background: #0056b3; }
        .btn-danger { background: #dc3545; }
        .btn-danger:hover { background: #c82333; }
        .btn-success { background: #28a745; }
        .btn-success:hover { background: #218838; }

        /* Responsive Table Container */
        .table-responsive { width: 100%; overflow-x: auto; margin-bottom: 20px; -webkit-overflow-scrolling: touch; }
        table { width: 100%; border-collapse: collapse; min-width: 600px; background: white; }
        th, td { padding: 10px; text-align: left; border-bottom: 1px solid #ddd; font-size: 14px; }
        th { background-color: #f8f9fa; color: #444; }

        .section-box { margin-bottom: 30px; background: #fff; padding: 15px; border-radius: 6px; border: 1px solid #e1e4e8; }
        select, input[type="text"], input[type="number"] { padding: 6px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; }
        
        @media (max-width: 480px) {
            body { padding: 5px; }
            .container { padding: 10px; }
            .header-flex { flex-direction: column; align-items: stretch; }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="header-flex">
            <h2>Category: <%= categoryName %></h2>
            <div>
                <a href="/admin/add-product" class="btn btn-success">+ Add Product</a>
                <a href="/admin/dashboard" class="btn">← Dashboard</a>
            </div>
        </div>

        <!-- Products Section -->
        <div class="section-box">
            <h3>Products in this Category</h3>
            <% if (products && products.length > 0) { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Brand</th>
                                <th>Price</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% products.forEach(product => { %>
                                <tr>
                                    <td><%= product.title %></td>
                                    <td><%= product.brand %></td>
                                    <td>₹<%= product.price %></td>
                                    <td>
                                        <a href="/admin/edit-product/<%= product._id %>" class="btn" style="padding: 4px 8px; font-size: 12px;">Edit</a>
                                        <form action="/admin/delete-product/<%= product._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <button type="submit" class="btn btn-danger" style="padding: 4px 8px; font-size: 12px;">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p>No products found in this category.</p>
            <% } %>
        </div>

        <!-- New Orders Section -->
        <div class="section-box">
            <h3>New Orders</h3>
            <% if (newOrders && newOrders.length > 0) { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th>Product</th>
                                <th>Location</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% newOrders.forEach(order => { %>
                                <tr>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.phone %></td>
                                    <td><%= order.product ? order.product.title : 'N/A' %></td>
                                    <td><%= order.location %></td>
                                    <td>
                                        <form action="/admin/order/pack/<%= order._id %>" method="POST" style="display:inline;">
                                            <button type="submit" class="btn btn-success" style="padding: 4px 8px; font-size: 12px;">Pack Order</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p>No new orders.</p>
            <% } %>
        </div>

        <!-- Packed Orders Section -->
        <div class="section-box">
            <h3>Packed Orders (Ready to Dispatch)</h3>
            <% if (packedOrders && packedOrders.length > 0) { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th>Product</th>
                                <th>Assign Delivery Boy & Dispatch</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% packedOrders.forEach(order => { %>
                                <tr>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.phone %></td>
                                    <td><%= order.product ? order.product.title : 'N/A' %></td>
                                    <td>
                                        <form action="/admin/order/dispatch/<%= order._id %>" method="POST" style="display: flex; gap: 5px; flex-wrap: wrap;">
                                            <select name="deliveryBoyId" required style="font-size: 12px;">
                                                <option value="">Select Delivery Boy</option>
                                                <% deliveryBoys.forEach(boy => { %>
                                                    <option value="<%= boy.id %>"><%= boy.id %></option>
                                                <% }) %>
                                            </select>
                                            <input type="text" name="manualSecretCode" placeholder="Secret Code" style="width: 90px; font-size: 12px;">
                                            <button type="submit" class="btn btn-success" style="padding: 4px 8px; font-size: 12px;">Dispatch</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p>No packed orders.</p>
            <% } %>
        </div>

        <!-- Out For Delivery Section -->
        <div class="section-box">
            <h3>Out For Delivery</h3>
            <% if (outForDeliveryOrders && outForDeliveryOrders.length > 0) { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th>Assigned Boy</th>
                                <th>Secret Key</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% outForDeliveryOrders.forEach(order => { %>
                                <tr>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.phone %></td>
                                    <td><%= order.deliveryBoyId %></td>
                                    <td><strong><%= order.secretKey %></strong></td>
                                    <td>
                                        <form action="/admin/order/status/<%= order._id %>" method="POST" style="display:inline;">
                                            <input type="hidden" name="status" value="Delivered">
                                            <button type="submit" class="btn btn-success" style="padding: 4px 8px; font-size: 12px;">Mark Delivered</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p>No orders out for delivery.</p>
            <% } %>
        </div>

        <!-- Delivered Orders Section -->
        <div class="section-box">
            <h3>Delivered Orders</h3>
            <% if (deliveredOrders && deliveredOrders.length > 0) { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th>Product</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% deliveredOrders.forEach(order => { %>
                                <tr>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.phone %></td>
                                    <td><%= order.product ? order.product.title : 'N/A' %></td>
                                    <td>
                                        <form action="/admin/order/delete/<%= order._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this order record?');">
                                            <button type="submit" class="btn btn-danger" style="padding: 4px 8px; font-size: 12px;">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p>No delivered orders history.</p>
            <% } %>
        </div>

    </div>

</body>
</html>
