<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= categoryName %> - Order & Product Management</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --dark: #1e293b;
            --light: #f8fafc;
            --gray: #64748b;
            --border: #e2e8f0;
        }

        body { 
            font-family: 'Inter', sans-serif; 
            margin: 0; 
            background-color: var(--light); 
            color: var(--dark); 
        }

        header { 
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); 
            color: white; 
            padding: 18px 24px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            position: sticky;
            top: 0;
            z-index: 100;
        }

        header h2 { margin: 0; font-size: 20px; font-weight: 600; }

        .container { max-width: 1400px; margin: 30px auto; padding: 0 20px; }

        .back-btn { 
            background: rgba(255, 255, 255, 0.1); 
            color: white; 
            padding: 8px 16px; 
            text-decoration: none; 
            border-radius: 6px; 
            font-size: 13px; 
            font-weight: 500;
        }
        
        .section-box { 
            background: white; 
            border: 1px solid var(--border); 
            border-radius: 12px; 
            margin-bottom: 35px; 
            padding: 24px; 
        }

        .section-title { 
            font-weight: 700; 
            font-size: 18px; 
            border-bottom: 2px solid var(--border);
            padding-bottom: 12px; 
            margin-bottom: 20px; 
        }
        
        .table-controls { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            margin-bottom: 18px; 
            gap: 12px; 
        }

        .search-box input { 
            padding: 10px 14px; 
            width: 240px; 
            border: 1px solid var(--border); 
            border-radius: 8px; 
        }

        .table-responsive { width: 100%; overflow-x: auto; border: 1px solid var(--border); border-radius: 8px; }

        table { width: 100%; border-collapse: collapse; font-size: 13px; white-space: nowrap; }

        th, td { border-bottom: 1px solid var(--border); padding: 12px 14px; text-align: center; }

        th { background: #f1f5f9; color: #475569; font-weight: 600; font-size: 11px; }

        img { border-radius: 6px; }
        
        .export-btn { 
            margin-top: 18px; 
            float: right; 
            background: white; 
            border: 1px solid var(--success); 
            color: var(--success); 
            padding: 8px 18px; 
            font-weight: 600; 
            cursor: pointer; 
            border-radius: 8px; 
        }

        .action-btn { 
            padding: 6px 14px; 
            background: var(--primary); 
            color: white; 
            border: none; 
            border-radius: 6px; 
            cursor: pointer; 
        }

        .cancel-btn { background: var(--danger); }
    </style>
</head>
<body>

    <header>
        <h2>Category: <%= categoryName %></h2>
        <a href="/admin/dashboard" class="back-btn">Back to Dashboard</a>
    </header>

    <div class="container">

        <!-- ================= TABLE 1: NEW ORDER ITEM ================= -->
        <div class="section-box">
            <div class="section-title">New Order Item</div>
            <div class="table-controls">
                <div class="search-box"><input type="text" placeholder="Search here..." onkeyup="filterTable(this, 'newTable')"></div>
            </div>
            <div class="table-responsive">
                <table id="newTable">
                    <thead>
                        <tr>
                            <th>S.N.</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Price / Details</th>
                            <th>Total Amount</th>
                            <th>Product Name</th>
                            <th>Product Image</th>
                            <th>Customer Name</th>
                            <th>Mobile No.</th>
                            <th>Customer Location</th>
                            <th>Confirm Status</th>
                            <th>Item Packed</th>
                            <th>Item Cancel</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (newOrders && newOrders.length > 0) { %>
                            <% newOrders.forEach((order, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                    <td><%= new Date(order.createdAt).toLocaleTimeString() %></td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %>
                                                <div>₹<%= item.price %> (x<%= item.quantity || 1 %>)</div>
                                            <% }) %>
                                        <% } else { %>
                                            ₹<%= order.product ? order.product.price : 'N/A' %>
                                        <% } %>
                                    </td>
                                    <td style="font-weight: 700; color: var(--primary);">
                                        ₹<%= order.totalAmount || (order.product ? order.product.price : 0) %>
                                    </td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %>
                                                <div><%= item.title || (item.product ? item.product.title : 'N/A') %></div>
                                            <% }) %>
                                        <% } else { %>
                                            <%= order.product ? order.product.title : 'N/A' %>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %>
                                                <% let imgUrl = item.image || (item.product && item.product.images ? item.product.images[0] : null); %>
                                                <% if (imgUrl) { %>
                                                    <img src="<%= imgUrl %>" width="40" height="40" style="object-fit:cover; margin:2px;">
                                                <% } %>
                                            <% }) %>
                                        <% } else if (order.product && order.product.images && order.product.images.length > 0) { %>
                                            <img src="<%= order.product.images[0] %>" width="40" height="40" style="object-fit:cover;">
                                        <% } %>
                                    </td>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.phone %></td>
                                    <td><%= order.location %></td>
                                    <td style="color: #10b981; font-weight: 600;">Confirm</td>
                                    <td>
                                        <form action="/admin/order/pack/<%= order._id %>" method="POST">
                                            <button type="submit" class="action-btn">Packed</button>
                                        </form>
                                    </td>
                                    <td>
                                        <form action="/admin/order/status/<%= order._id %>" method="POST" onsubmit="return confirmCancel(this)">
                                            <input type="hidden" name="status" value="Canceled">
                                            <input type="hidden" name="cancelReason" value="Canceled from New Order stage">
                                            <button type="submit" class="action-btn cancel-btn">Cancel</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="13" style="text-align: center; color: #64748b; padding: 24px;">No new orders found.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <button class="export-btn" onclick="exportTableToExcel('newTable', '<%= categoryName %>_New_Orders')">Export In Excel</button>
        </div>

        <!-- ================= TABLE 2: PACKED ITEM ================= -->
        <div class="section-box">
            <div class="section-title">Packed Item</div>
            <div class="table-responsive">
                <table id="packedTable">
                    <thead>
                        <tr>
                            <th>S.N.</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Price / Details</th>
                            <th>Total Amount</th>
                            <th>Product Name</th>
                            <th>Product Image</th>
                            <th>Customer Name</th>
                            <th>Mobile No.</th>
                            <th>Customer Location</th>
                            <th>Confirm Status</th>
                            <th>Delivery Boy ID</th>
                            <th>Manual Secret code</th>
                            <th>Out For Delivery</th>
                            <th>Item Cancel</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (packedOrders && packedOrders.length > 0) { %>
                            <% packedOrders.forEach((order, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                    <td><%= new Date(order.createdAt).toLocaleTimeString() %></td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %>
                                                <div>₹<%= item.price %> (x<%= item.quantity || 1 %>)</div>
                                            <% }) %>
                                        <% } else { %>
                                            ₹<%= order.product ? order.product.price : 'N/A' %>
                                        <% } %>
                                    </td>
                                    <td style="font-weight: 700; color: var(--primary);">₹<%= order.totalAmount || 0 %></td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %>
                                                <div><%= item.title || 'N/A' %></div>
                                            <% }) %>
                                        <% } else { %>
                                            <%= order.product ? order.product.title : 'N/A' %>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %>
                                                <% if (item.image) { %><img src="<%= item.image %>" width="40" height="40" style="object-fit:cover; margin:2px;"><% } %>
                                            <% }) %>
                                        <% } else if (order.product && order.product.images) { %>
                                            <img src="<%= order.product.images[0] %>" width="40" height="40" style="object-fit:cover;">
                                        <% } %>
                                    </td>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.phone %></td>
                                    <td><%= order.location %></td>
                                    <td style="color: #10b981; font-weight: 600;">Confirm</td>
                                    <form action="/admin/order/dispatch/<%= order._id %>" method="POST">
                                        <td>
                                            <select name="deliveryBoyId" required>
                                                <option value="">Select Delivery Boy</option>
                                                <% deliveryBoys.forEach(boy => { %>
                                                    <option value="<%= boy.id %>"><%= boy.id %></option>
                                                <% }) %>
                                            </select>
                                        </td>
                                        <td><input type="text" name="manualSecretCode" value="<%= order.secretKey %>" required style="width: 70px; text-align: center;"></td>
                                        <td><button type="submit" class="action-btn" style="background: #f59e0b; color: #fff;">Dispatch</button></td>
                                    </form>
                                    <td>
                                        <form action="/admin/order/status/<%= order._id %>" method="POST" onsubmit="return confirmCancel(this)">
                                            <input type="hidden" name="status" value="Canceled">
                                            <input type="hidden" name="cancelReason" value="Canceled from Packed stage">
                                            <button type="submit" class="action-btn cancel-btn">Cancel</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="15" style="text-align: center; color: #64748b; padding: 24px;">No packed orders found.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <button class="export-btn" onclick="exportTableToExcel('packedTable', '<%= categoryName %>_Packed_Orders')">Export In Excel</button>
        </div>

        <!-- ================= TABLE 3: OUT FOR DELIVERY ================= -->
        <div class="section-box">
            <div class="section-title">Out For Delivery</div>
            <div class="table-responsive">
                <table id="ofdTable">
                    <thead>
                        <tr>
                            <th>S.N.</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Price / Details</th>
                            <th>Total Amount</th>
                            <th>Product Name</th>
                            <th>Product Image</th>
                            <th>Customer Name</th>
                            <th>Mobile No.</th>
                            <th>Customer Location</th>
                            <th>Delivery Boy ID</th>
                            <th>Secret Code</th>
                            <th>Delivery Status</th>
                            <th>Item Cancel</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (outForDeliveryOrders && outForDeliveryOrders.length > 0) { %>
                            <% outForDeliveryOrders.forEach((order, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                    <td><%= new Date(order.createdAt).toLocaleTimeString() %></td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %><div>₹<%= item.price %> (x<%= item.quantity || 1 %>)</div><% }) %>
                                        <% } else { %>₹<%= order.product ? order.product.price : 'N/A' %><% } %>
                                    </td>
                                    <td style="font-weight: 700; color: var(--primary);">₹<%= order.totalAmount || 0 %></td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %><div><%= item.title || 'N/A' %></div><% }) %>
                                        <% } else { %><%= order.product ? order.product.title : 'N/A' %><% } %>
                                    </td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %><% if (item.image) { %><img src="<%= item.image %>" width="40" height="40" style="object-fit:cover; margin:2px;"><% } %><% }) %>
                                        <% } else if (order.product && order.product.images) { %>
                                            <img src="<%= order.product.images[0] %>" width="40" height="40" style="object-fit:cover;">
                                        <% } %>
                                    </td>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.phone %></td>
                                    <td><%= order.location %></td>
                                    <td><%= order.deliveryBoyId %></td>
                                    <td><%= order.secretKey %></td>
                                    <td>
                                        <form action="/admin/order/status/<%= order._id %>" method="POST">
                                            <input type="hidden" name="status" value="Delivered">
                                            <button type="submit" class="action-btn" style="background: #10b981;">Mark Delivered</button>
                                        </form>
                                    </td>
                                    <td>
                                        <form action="/admin/order/status/<%= order._id %>" method="POST" onsubmit="return confirmCancel(this)">
                                            <input type="hidden" name="status" value="Canceled">
                                            <input type="hidden" name="cancelReason" value="Canceled from Out For Delivery stage">
                                            <button type="submit" class="action-btn cancel-btn">Cancel</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="14" style="text-align: center; color: #64748b; padding: 24px;">No orders out for delivery.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <button class="export-btn" onclick="exportTableToExcel('ofdTable', '<%= categoryName %>_OutForDelivery_Orders')">Export In Excel</button>
        </div>

        <!-- ================= TABLE 4: DELIVERED ITEM ================= -->
        <div class="section-box">
            <div class="section-title">Delivered Item</div>
            <div class="table-responsive">
                <table id="deliveredTable">
                    <thead>
                        <tr>
                            <th>S.N.</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Price / Details</th>
                            <th>Total Amount</th>
                            <th>Product Name</th>
                            <th>Product Image</th>
                            <th>Customer Name</th>
                            <th>Mobile No.</th>
                            <th>Customer Location</th>
                            <th>Delivered Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (deliveredOrders && deliveredOrders.length > 0) { %>
                            <% deliveredOrders.forEach((order, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                    <td><%= new Date(order.createdAt).toLocaleTimeString() %></td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %><div>₹<%= item.price %> (x<%= item.quantity || 1 %>)</div><% }) %>
                                        <% } else { %>₹<%= order.product ? order.product.price : 'N/A' %><% } %>
                                    </td>
                                    <td style="font-weight: 700; color: var(--primary);">₹<%= order.totalAmount || 0 %></td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %><div><%= item.title || 'N/A' %></div><% }) %>
                                        <% } else { %><%= order.product ? order.product.title : 'N/A' %><% } %>
                                    </td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %><% if (item.image) { %><img src="<%= item.image %>" width="40" height="40" style="object-fit:cover; margin:2px;"><% } %><% }) %>
                                        <% } else if (order.product && order.product.images) { %>
                                            <img src="<%= order.product.images[0] %>" width="40" height="40" style="object-fit:cover;">
                                        <% } %>
                                    </td>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.phone %></td>
                                    <td><%= order.location %></td>
                                    <td style="color: #10b981; font-weight: 600;">Successfully Delivered</td>
                                    <td>
                                        <form action="/admin/order/delete/<%= order._id %>" method="POST" onsubmit="return confirm('Delete this record?')">
                                            <button type="submit" class="action-btn cancel-btn">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="12" style="text-align: center; color: #64748b; padding: 24px;">No delivered items found.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <button class="export-btn" onclick="exportTableToExcel('deliveredTable', '<%= categoryName %>_Delivered_Orders')">Export In Excel</button>
        </div>

        <!-- ================= TABLE 5: CANCELED ITEM ================= -->
        <div class="section-box">
            <div class="section-title">Canceled Item</div>
            <div class="table-responsive">
                <table id="canceledTable">
                    <thead>
                        <tr>
                            <th>S.N.</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Price / Details</th>
                            <th>Total Amount</th>
                            <th>Product Name</th>
                            <th>Product Image</th>
                            <th>Customer Name</th>
                            <th>Mobile No.</th>
                            <th>Customer Location</th>
                            <th>Cancel Reason</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (canceledOrders && canceledOrders.length > 0) { %>
                            <% canceledOrders.forEach((order, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                    <td><%= new Date(order.createdAt).toLocaleTimeString() %></td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %><div>₹<%= item.price %> (x<%= item.quantity || 1 %>)</div><% }) %>
                                        <% } else { %>₹<%= order.product ? order.product.price : 'N/A' %><% } %>
                                    </td>
                                    <td style="font-weight: 700; color: var(--primary);">₹<%= order.totalAmount || 0 %></td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %><div><%= item.title || 'N/A' %></div><% }) %>
                                        <% } else { %><%= order.product ? order.product.title : 'N/A' %><% } %>
                                    </td>
                                    <td>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <% order.items.forEach(item => { %><% if (item.image) { %><img src="<%= item.image %>" width="40" height="40" style="object-fit:cover; margin:2px;"><% } %><% }) %>
                                        <% } else if (order.product && order.product.images) { %>
                                            <img src="<%= order.product.images[0] %>" width="40" height="40" style="object-fit:cover;">
                                        <% } %>
                                    </td>
                                    <td><%= order.customerName %></td>
                                    <td><%= order.phone %></td>
                                    <td><%= order.location %></td>
                                    <td style="color: #ef4444; font-weight: 600;"><%= order.cancelReason || 'Canceled' %></td>
                                    <td>
                                        <form action="/admin/order/delete/<%= order._id %>" method="POST" onsubmit="return confirm('Delete this record?')">
                                            <button type="submit" class="action-btn cancel-btn">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="12" style="text-align: center; color: #64748b; padding: 24px;">No canceled items found.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <button class="export-btn" onclick="exportTableToExcel('canceledTable', '<%= categoryName %>_Canceled_Orders')">Export In Excel</button>
        </div>

    </div>

    <script>
        function filterTable(input, tableId) {
            let filter = input.value.toLowerCase();
            let tr = document.getElementById(tableId).getElementsByTagName("tr");
            for (let i = 1; i < tr.length; i++) {
                let match = false;
                let td = tr[i].getElementsByTagName("td");
                for (let j = 0; j < td.length; j++) {
                    if (td[j] && td[j].innerText.toLowerCase().indexOf(filter) > -1) {
                        match = true;
                        break;
                    }
                }
                tr[i].style.display = match ? "" : "none";
            }
        }

        function confirmCancel(form) {
            let reason = prompt("Enter cancellation reason:");
            if (!reason || !reason.trim()) return false;
            form.querySelector('input[name="cancelReason"]').value = reason;
            return true;
        }

        function exportTableToExcel(tableId, filename) {
            let tableHTML = document.getElementById(tableId).outerHTML.replace(/<form[^>]*>|<\/form>/gi, '');
            let blob = new Blob(['\ufeff', tableHTML], { type: 'application/vnd.ms-excel' });
            let url = URL.createObjectURL(blob);
            let a = document.createElement("a");
            a.href = url;
            a.download = filename + '.xls';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }
    </script>
</body>
</html>
