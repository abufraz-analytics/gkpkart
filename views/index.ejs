<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GkpKart - Mobiles & Electronics Gorakhpur</title>
    <link rel="icon" type="image/x-icon" href="g.ico">
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f4f9; margin: 0; padding: 0; }
        header { background-color: #2874f0; color: white; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
        header h1 { margin: 0; font-size: 24px; }
        .search-form { display: flex; gap: 5px; flex: 1; max-width: 400px; }
        .search-form input { flex: 1; padding: 8px 12px; border: none; border-radius: 4px; font-size: 14px; }
        .search-form button { background-color: #ff9f00; color: white; border: none; padding: 8px 15px; border-radius: 4px; font-weight: bold; cursor: pointer; }
        .search-form button:hover { background-color: #fb641b; }
        .container { max-width: 1200px; margin: 30px auto; padding: 0 20px; }
        .banner { background: linear-gradient(135deg, #2874f0, #174ea6); color: white; padding: 30px; border-radius: 8px; text-align: center; margin-bottom: 30px; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
        .product-card { background: white; border: 1px solid #e1e1e1; border-radius: 8px; padding: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); display: flex; flex-direction: column; justify-content: space-between; }
        .product-card img { width: 100%; height: 200px; object-fit: cover; border-radius: 4px; }
        .product-title { font-size: 16px; font-weight: bold; color: #333; margin: 10px 0 5px 0; }
        .product-brand { color: #666; font-size: 14px; margin-bottom: 5px; }
        .product-price { font-size: 18px; color: #b12704; font-weight: bold; margin-bottom: 10px; }
        .details-btn { display: block; text-align: center; background-color: #ff9f00; color: white; padding: 10px; text-decoration: none; border-radius: 4px; font-weight: bold; }
        .details-btn:hover { background-color: #fb641b; }
        .admin-link { 
            display: none; /* Shuruat mein chhipa rahega */
            background-color: #ff9f00; 
            color: white; 
            padding: 8px 15px; 
            text-decoration: none; 
            border-radius: 4px; 
            font-weight: bold; 
            white-space: nowrap; 
        }
    </style>
</head>
<body>

    <header>
        <h1>🛒 GkpKart</h1>
        
        <!-- Search Bar Form -->
        <form action="/" method="GET" class="search-form">
            <input type="text" name="search" placeholder="Search for mobiles, electronics..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            <button type="submit">Search</button>
        </form>

        <div>
            <a href="/admin/login" class="admin-link">Admin Login</a>
        </div>
    </header>

    <div class="container">
        <div class="banner">
            <h2>Gorakhpur's Trusted Mobile & Electronics Store</h2>
            <p>Get the best deals on latest smartphones and electronics with direct WhatsApp support!</p>
        </div>

        <h2 style="color: #333; border-bottom: 2px solid #ddd; padding-bottom: 8px;">
            <%= typeof searchQuery !== 'undefined' && searchQuery ? `Search Results for "${searchQuery}"` : "Available Products" %>
        </h2>

        <% if (products.length === 0) { %>
            <p style="text-align: center; color: #666; font-size: 18px; margin-top: 40px;">No products found. Try searching something else or add products via Admin Panel!</p>
        <% } else { %>
            <div class="product-grid">
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <div>
                            <!-- Fixed Image Path check for both multiple array images and single image -->
                            <% 
                                let displayImg = '';
                                if (product.images && product.images.length > 0) {
                                    displayImg = product.images[0];
                                } else if (product.image) {
                                    displayImg = product.image;
                                } else {
                                    displayImg = 'https://via.placeholder.com/200';
                                }
                            %>
                            <img src="<%= displayImg %>" alt="<%= product.title %>">

                            <div class="product-title"><%= product.title %></div>
                            <div class="product-brand">Brand: <%= product.brand %></div>
                            <div class="product-price">₹<%= product.price %></div>
                        </div>
                        <a href="/product/<%= product._id %>" class="details-btn">View Details & Buy</a>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <script>
        let tapCount = 0;
        let tapTimer = null;

        // Header par click/tap count karne ke liye
        const headerTitle = document.querySelector('header h1'); // "🛒 GkpKart" wale title par click count hoga

        if (headerTitle) {
            headerTitle.style.cursor = 'pointer'; // Cursor pointer ban jayega taaki pata chale
            headerTitle.addEventListener('click', () => {
                tapCount++;
                
                // Agar 2 second ke andar agli tap nahi hui, toh count reset ho jayega
                clearTimeout(tapTimer);
                tapTimer = setTimeout(() => {
                    tapCount = 0;
                }, 2000);

                // Jaise hi 4 continuous tap honge
                if (tapCount === 4) {
                    const adminBtn = document.querySelector('.admin-link');
                    if (adminBtn) {
                        adminBtn.style.display = 'inline-block'; // Admin button wapas dikhne lagega
                        alert('Admin Mode Unlocked!');
                    }
                    tapCount = 0;
                }
            });
        }
    </script>

</body>
</html>
