<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GkpKart - Gorakhpur's Trusted Store</title>
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --accent: #f59e0b;
            --success: #10b981;
            --bg-color: #f8fafc;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.5;
            padding-top: 0; /* Handled via Javascript/Sticky Header */
        }

        /* Top Fixed Sticky Container */
        .sticky-wrapper {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: var(--bg-color);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease-in-out;
        }

        /* Header Styles */
        header {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: transform 0.3s ease, height 0.3s ease, padding 0.3s ease;
            overflow: hidden;
            height: 60px;
        }

        /* Class to Hide Header smoothly on Downward Scroll */
        .sticky-wrapper.hide-header header {
            height: 0;
            padding-top: 0;
            padding-bottom: 0;
            opacity: 0;
            transform: translateY(-100%);
        }

        .logo-area {
            font-size: 20px;
            font-weight: 800;
            cursor: pointer;
            user-select: none;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        .logo-area:active {
            transform: scale(0.96);
        }

        .nav-links {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: nowrap;
        }

        .view-order-btn {
            background: var(--success);
            color: white;
            padding: 8px 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 13px;
            border-radius: 6px;
            white-space: nowrap;
            transition: background 0.2s;
            box-shadow: 0 2px 4px rgba(16, 185, 129, 0.2);
        }

        .view-order-btn:hover {
            background: #059669;
        }

        .hidden-btn {
            display: none;
            background: var(--accent);
            color: #111827;
            padding: 8px 10px;
            text-decoration: none;
            font-weight: 700;
            font-size: 12px;
            border-radius: 6px;
            white-space: nowrap;
            animation: fadeIn 0.3s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Search Section */
        .search-container {
            padding: 8px 12px;
            background: var(--bg-color);
        }

        .search-container form {
            display: flex;
            width: 100%;
            max-width: 600px;
            margin: auto;
            background: white;
            border-radius: 50px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            border: 1px solid var(--border-color);
            overflow: hidden;
        }

        .search-container input {
            flex: 1;
            padding: 10px 16px;
            border: none;
            outline: none;
            font-size: 14px;
            color: var(--text-main);
            background: transparent;
        }

        .search-container button {
            padding: 0 16px;
            background: var(--accent);
            color: #111827;
            border: none;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
        }

        /* Tight Category Filter Pills */
        .category-filter {
            display: flex;
            justify-content: flex-start;
            gap: 6px;
            overflow-x: auto;
            white-space: nowrap;
            padding: 4px 12px 8px;
            max-width: 1200px;
            margin: auto;
            background: var(--bg-color);
            -webkit-overflow-scrolling: touch;
        }

        .category-filter::-webkit-scrollbar {
            display: none; /* Hide scrollbar for clean UI */
        }

        .category-filter a {
            padding: 5px 12px;
            background: white;
            color: var(--text-muted);
            text-decoration: none;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            border: 1px solid var(--border-color);
            flex-shrink: 0;
        }

        .category-filter a.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        /* Products Display Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 16px;
            padding: 12px 16px 40px;
            max-width: 1200px;
            margin: auto;
        }

        .product-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 12px;
            text-align: center;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s ease;
        }

        .product-card:hover {
            transform: translateY(-3px);
            border-color: rgba(37, 99, 235, 0.3);
        }

        .image-wrapper {
            width: 100%;
            height: 180px;
            overflow: hidden;
            border-radius: 6px;
            background: #f1f5f9;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-card h3 {
            font-size: 14px;
            font-weight: 600;
            margin: 6px 0;
            color: var(--text-main);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 38px;
        }

        .product-card p {
            color: #e11d48;
            font-weight: 700;
            font-size: 16px;
            margin-bottom: 8px;
        }

        .buy-btn {
            display: block;
            width: 100%;
            padding: 8px;
            background: var(--accent);
            color: #111827;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 700;
            font-size: 13px;
        }

        .no-products {
            grid-column: 1 / -1;
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
            background: white;
            border-radius: 10px;
            border: 1px dashed var(--border-color);
        }

        /* Mobile Adjustments */
        @media (max-width: 768px) {
            header {
                padding: 10px 12px;
                height: 52px;
            }
            .logo-area {
                font-size: 18px;
            }
            .products-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                gap: 10px;
                padding: 10px 8px 30px;
            }
            .product-card {
                padding: 8px;
            }
            .image-wrapper {
                height: 140px;
            }
            .product-card h3 {
                font-size: 13px;
                height: 36px;
            }
            .product-card p {
                font-size: 15px;
            }
        }
    </style>
</head>
<body>

    <!-- Sticky Header Wrapper -->
    <div class="sticky-wrapper" id="stickyWrapper">
        <header>
            <!-- Logo Left Side -->
            <div class="logo-area" id="logoClick">🛒 GkpKart</div>

            <!-- Buttons Right Side -->
            <div class="nav-links">
                <a href="/view-orders" class="view-order-btn">View Order</a>
                <a href="/delivery/login" id="deliveryLoginBtn" class="hidden-btn">Delivery</a>
                <a href="/admin/login" id="adminLoginBtn" class="hidden-btn">Admin</a>
            </div>
        </header>

        <!-- Search Bar -->
        <div class="search-container">
            <form action="/" method="GET">
                <input type="text" name="search" placeholder="Search products..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                <button type="submit">Search</button>
            </form>
        </div>

        <!-- Tight Category Pills -->
        <div class="category-filter">
            <a href="/" class="<%= !selectedCategory ? 'active' : '' %>">All</a>
            <a href="/?category=Shoes" class="<%= selectedCategory === 'Shoes' ? 'active' : '' %>">Shoes</a>
            <a href="/?category=Mobile Accessories" class="<%= selectedCategory === 'Mobile Accessories' ? 'active' : '' %>">Mobile</a>
            <a href="/?category=Small Electric Item" class="<%= selectedCategory === 'Small Electric Item' ? 'active' : '' %>">Small Electric</a>
            <a href="/?category=Big Electric Item" class="<%= selectedCategory === 'Big Electric Item' ? 'active' : '' %>">Big Electric</a>
            <a href="/?category=Ladies - Gents Makeup Items" class="<%= selectedCategory === 'Ladies - Gents Makeup Items' ? 'active' : '' %>">Makeup</a>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="products-grid">
        <% if (products && products.length > 0) { %>
            <% products.forEach(product => { %>
                <div class="product-card">
                    <div class="image-wrapper">
                        <% if (product.images && product.images.length > 0) { %>
                            <img src="<%= product.images[0] %>" alt="<%= product.title %>">
                        <% } else { %>
                            <img src="/placeholder.png" alt="No image">
                        <% } %>
                    </div>
                    <h3><%= product.title %></h3>
                    <p>₹<%= product.price %></p>
                    <a href="/product/<%= product._id %>" class="buy-btn">View & Buy</a>
                </div>
            <% }) %>
        <% } else { %>
            <div class="no-products">
                <p>No products found matching your search or category.</p>
            </div>
        <% } %>
    </div>

    <script>
        // 4-Clicks Logic on Logo to reveal Login Buttons
        let clickCount = 0;
        const logo = document.getElementById('logoClick');
        const adminBtn = document.getElementById('adminLoginBtn');
        const deliveryBtn = document.getElementById('deliveryLoginBtn');

        logo.addEventListener('click', () => {
            clickCount++;
            if (clickCount >= 4) {
                adminBtn.style.display = 'inline-block';
                deliveryBtn.style.display = 'inline-block';
                alert('Admin & Delivery Login unlocked!');
                clickCount = 0;
            }
        });

        // Dynamic Header Hide/Show on Scroll Logic
        let lastScrollY = window.scrollY;
        const stickyWrapper = document.getElementById('stickyWrapper');

        window.addEventListener('scroll', () => {
            const currentScrollY = window.scrollY;

            // Scroll Down -> Hide Header Logo Bar (Keep Search & Category Sticky)
            if (currentScrollY > lastScrollY && currentScrollY > 60) {
                stickyWrapper.classList.add('hide-header');
            } 
            // Scroll Up Even Slightly -> Instantly Show Header Logo Bar
            else if (currentScrollY < lastScrollY) {
                stickyWrapper.classList.remove('hide-header');
            }

            lastScrollY = currentScrollY;
        });
    </script>
</body>
</html>
