<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GkpKart - Gorakhpur's Trusted Store</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background-color: #f4f6f9; }
        header { background: #007bff; color: white; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; }
        .logo-area { font-size: 24px; font-weight: bold; cursor: pointer; user-select: none; }
        .nav-links { display: flex; gap: 10px; align-items: center; }
        .hidden-btn { display: none; background: #ffc107; color: #000; padding: 8px 15px; text-decoration: none; font-weight: bold; border-radius: 4px; }
        .view-order-btn { background: #28a745; color: white; padding: 8px 15px; text-decoration: none; font-weight: bold; border-radius: 4px; display: inline-block; }
        .search-container { margin: 20px; text-align: center; }
        .search-container input { padding: 10px; width: 50%; max-width: 400px; border: 1px solid #ccc; border-radius: 4px; }
        .search-container button { padding: 10px 20px; background: #ff9800; color: white; border: none; border-radius: 4px; cursor: pointer; }
        .category-filter { text-align: center; margin-bottom: 20px; }
        .category-filter a { margin: 0 5px; padding: 8px 15px; background: #e9ecef; color: #333; text-decoration: none; border-radius: 20px; font-size: 14px; }
        .category-filter a.active { background: #007bff; color: white; }
        .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; padding: 20px; max-width: 1200px; margin: auto; }
        .product-card { background: white; border: 1px solid #ddd; border-radius: 6px; padding: 15px; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .product-card img { max-width: 100%; height: 180px; object-fit: cover; border-radius: 4px; }
        .product-card h3 { font-size: 18px; margin: 10px 0; color: #333; }
        .product-card p { color: #d9534f; font-weight: bold; font-size: 16px; }
        .buy-btn { display: block; margin-top: 10px; padding: 10px; background: #ff9800; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; }
    </style>
</head>
<body>

    <header>
        <!-- Logo with 4-click trigger for Admin & Delivery Logins -->
        <div class="logo-area" id="logoClick">🛒 GkpKart</div>

        <div class="nav-links">
            <!-- View Your Order (Always Visible, Local Tracking) -->
            <a href="/view-orders" class="view-order-btn">View Your Order</a>

            <!-- Hidden Login Buttons (Revealed after 4 clicks on Logo) -->
            <a href="/delivery/login" id="deliveryLoginBtn" class="hidden-btn">Login Delivery</a>
            <a href="/admin/login" id="adminLoginBtn" class="hidden-btn">Login Admin</a>
        </div>
    </header>

    <!-- Search Section -->
    <div class="search-container">
        <form action="/" method="GET">
            <input type="text" name="search" placeholder="Search for mobiles, electronics, shoes..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            <button type="submit">Search</button>
        </form>
    </div>

    <!-- Category Filter Pills -->
    <div class="category-filter">
        <a href="/" class="<%= !selectedCategory ? 'active' : '' %>">All Products</a>
        <a href="/?category=Shoes" class="<%= selectedCategory === 'Shoes' ? 'active' : '' %>">Shoes</a>
        <a href="/?category=Mobile Accessories" class="<%= selectedCategory === 'Mobile Accessories' ? 'active' : '' %>">Mobile Accessories</a>
        <a href="/?category=Small Electric Item" class="<%= selectedCategory === 'Small Electric Item' ? 'active' : '' %>">Small Electric Item</a>
        <a href="/?category=Big Electric Item" class="<%= selectedCategory === 'Big Electric Item' ? 'active' : '' %>">Big Electric Item</a>
        <a href="/?category=Ladies & Gents Makeup Items" class="<%= selectedCategory === 'Ladies & Gents Makeup Items' ? 'active' : '' %>">Makeup Items</a>
    </div>

    <!-- Products Display Grid -->
    <div class="products-grid">
        <% if (products && products.length > 0) { %>
            <% products.forEach(product => { %>
                <div class="product-card">
                    <% if (product.images && product.images.length > 0) { %>
                        <img src="<%= product.images[0] %>" alt="<%= product.title %>">
                    <% } %>
                    <h3><%= product.title %></h3>
                    <p>₹<%= product.price %></p>
                    <a href="/product/<%= product._id %>" class="buy-btn">View Details & Buy</a>
                </div>
            <% }) %>
        <% } else { %>
            <p style="text-align: center; width: 100%; color: #777;">No products found.</p>
        <% } %>
    </div>

    <script>
        // 4-Clicks Logic on Logo to reveal Login Buttons
        let clickCount = 0;
        const logo = document.getElementById('logoClick');
        const adminBtn = document.getElementById('adminLoginBtn');
        const deliveryBtn = document.getElementById('deliveryLoginBtn');

        logo.addEventListener('click', () => {
            clickCount++;
            if (clickCount >= 4) {
                adminBtn.style.display = 'inline-block';
                deliveryBtn.style.display = 'inline-block';
                alert('Admin & Delivery Login unlocked!');
                clickCount = 0;
            }
        });
    </script>
</body>
</html>
